# =============================================================
# 大学生智能财务管理平台（CSAIFM）环境变量示例
# docker compose 方式：复制为项目根目录 .env
# 本地开发方式：复制为 backend/.env（后端从运行目录读取）
# 除数据库外，所有变量都有安全的开发默认值，可留空。
# =============================================================

# —— 数据库（PostgreSQL，本项目将需求文档中的 MySQL 改为 PostgreSQL）——
POSTGRES_USER=csaifm
POSTGRES_PASSWORD=csaifm
POSTGRES_DB=csaifm
# 本地开发（非 Docker）时的完整连接串；Docker 内由 compose 自动注入
DATABASE_URL=postgresql+psycopg://csaifm:csaifm@localhost:5433/csaifm

# —— 安全 ——
# 生产环境必须改为足够长的随机字符串（>= 32 字节）
JWT_SECRET=dev-only-secret-please-change-32bytes-minimum
JWT_EXPIRE_MINUTES=10080

# —— 登录锁定（SRS 数据词典：连续 3 次失败锁定 15 分钟）——
LOGIN_MAX_FAILURES=3
LOGIN_LOCK_MINUTES=15

# —— CORS（前端开发地址；逗号分隔）——
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# —— 预算提醒与超支预测阈值 ——
BUDGET_DEFAULT_THRESHOLD=80
FORECAST_HIGH_RISK_FACTOR=1.2

# —— 异常消费识别阈值 ——
ANOMALY_SINGLE_CENTS=30000
ANOMALY_SINGLE_FACTOR=3.0
ANOMALY_SINGLE_MIN_SAMPLES=5
ANOMALY_DAILY_FACTOR=2.0
ANOMALY_DAILY_FLOOR_CENTS=10000
ANOMALY_WINDOW_DAYS=30

# —— 学期划分（报告周期，可配置；MM-DD）——
SEMESTER_FALL_START=09-01
SEMESTER_FALL_END=01-20
SEMESTER_SPRING_START=02-20
SEMESTER_SPRING_END=07-10

# —— 外部 AI 服务（OpenAI 兼容接口；不配置则走本地演示模式）——
# auto=有密钥用外部服务，否则演示模式；demo=强制演示；external=强制外部
AI_MODE=auto
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
SPEECH_API_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1
OCR_API_BASE_URL=
OCR_API_KEY=
OCR_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20

# —— 报告导出目录（相对 backend 运行目录）——
EXPORT_DIR=exports

# —— 邮件（找回密码验证码；不配置时接口明确返回“未配置”，验证码仅在后端日志）——
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
RESET_CODE_MINUTES=5
